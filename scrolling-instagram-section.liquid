<style>
  .instagram-feed-section {
  width: 100%;
  overflow: hidden;
}

.instagram-feed-wrapper {
  max-width: 100%;
  margin: 0 auto;
  position: relative;
}

/* Scroll Container */
.instagram-scroll-container {
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  cursor: grab;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE/Edge */
  padding: 0 40px;
}

/* Marquee Mode */
.instagram-scroll-container--marquee {
  overflow: hidden !important;
  cursor: default !important;
  padding: 0 !important;
}

.instagram-scroll-container--marquee .instagram-grid {
  display: flex;
  width: max-content;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

.instagram-scroll-container::-webkit-scrollbar {
  display: none; /* Chrome/Safari */
}

.instagram-scroll-container.active {
  cursor: grabbing;
  scroll-behavior: auto;
}

/* Marquee Animations */
@keyframes marqueeScrollRight {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-100%);
  }
}

@keyframes marqueeScrollLeft {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(0);
  }
}

/* Horizontal Grid */
.instagram-grid {
  display: flex;
  gap: 20px;
  width: max-content;
  padding: 20px 0;
  align-items: flex-start;
  will-change: transform;
  min-height: 1000px;
}

.instagram-scroll-container--marquee .instagram-grid {
  padding: 20px 0;
  gap: 20px;
}

/* Image Item Styles */
.instagram-item {
  position: relative;
  overflow: hidden;
  border-radius: 8px;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  cursor: pointer;
  flex-shrink: 0;
  height: 400px;
}

.instagram-item:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
  z-index: 10;
}

.instagram-scroll-container--marquee .instagram-item:hover {
  transform: translateY(-8px) scale(1.02);
}

/* Size Variations - Width-based for horizontal scroll */
.instagram-item--small {
  width: 250px;
  height: 350px;
}

.instagram-item--medium {
  width: 300px;
  height: 400px;
}

.instagram-item--large {
  width: 400px;
  height: 500px;
}

/* Position variations affect vertical alignment within the row */
.instagram-item[data-position*="top"] {
  align-self: flex-start;
}

.instagram-item[data-position*="middle"] {
  align-self: center;
}

.instagram-item[data-position*="bottom"] {
  align-self: flex-end;
}

/* Image Link and Wrapper */
.instagram-link {
  display: block;
  width: 100%;
  height: 100%;
  position: relative;
}

.instagram-image-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.instagram-image-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.instagram-item:hover .instagram-image-wrapper img {
  transform: scale(1.05);
}

/* Overlay on Hover */
.instagram-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.instagram-item:hover .instagram-overlay {
  opacity: 1;
}

.instagram-icon {
  width: 40px;
  height: 40px;
  color: white;
}

/* Placeholder */
.instagram-placeholder {
  width: 100%;
  height: 100%;
  background: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.instagram-placeholder svg {
  width: 60px;
  height: 60px;
  opacity: 0.3;
}

/* Follow Text Section */
.instagram-follow-text {
  text-align: center;
  z-index: 10;
}

.instagram-follow-text--top {
  margin-bottom: 40px;
  padding: 0 40px;
}

.instagram-follow-text--center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
  z-index: 5;
}

.instagram-follow-text--center .instagram-account-link {
  pointer-events: all;
}

.instagram-follow-text--bottom {
  margin-top: 40px;
  padding: 0 40px;
}

.instagram-text {
  font-size: 16px;
  font-weight: 400;
  margin: 0 0 10px 0;
  letter-spacing: 0.5px;
}

.instagram-follow-text--center .instagram-text {
  font-size: 18px;
  text-shadow: 0 2px 10px rgba(255, 255, 255, 0.8);
}

.instagram-account-link {
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  letter-spacing: 1px;
  text-transform: uppercase;
  border-bottom: 1px solid currentColor;
  transition: opacity 0.3s ease;
  display: inline-block;
}

.instagram-follow-text--center .instagram-account-link {
  background: rgba(255, 255, 255, 0.9);
  padding: 8px 16px;
  border: none;
  border-radius: 4px;
}

.instagram-account-link:hover {
  opacity: 0.7;
}

/* Tablet Styles */
@media screen and (max-width: 1024px) {
  .instagram-scroll-container {
    padding: 0 20px;
  }

  .instagram-grid {
    gap: 15px;
  }

  .instagram-item--small {
    width: 220px;
    height: 320px;
  }

  .instagram-item--medium {
    width: 280px;
    height: 380px;
  }

  .instagram-item--large {
    width: 350px;
    height: 450px;
  }
}

/* Mobile Styles */
@media screen and (max-width: 768px) {
  .instagram-scroll-container {
    padding: 0 15px;
  }

  .instagram-scroll-container--marquee {
    padding: 0 !important;
  }

  .instagram-grid {
    gap: 12px;
  }

  .instagram-item {
    height: 300px;
  }

  .instagram-item--small {
    width: 200px;
    height: 280px;
  }

  .instagram-item--medium {
    width: 250px;
    height: 320px;
  }

  .instagram-item--large {
    width: 300px;
    height: 380px;
  }

  .instagram-icon {
    width: 30px;
    height: 30px;
  }

  .instagram-text {
    font-size: 14px;
  }

  .instagram-account-link {
    font-size: 12px;
  }

  .instagram-follow-text--top,
  .instagram-follow-text--bottom {
    padding: 0 15px;
  }
}

/* Small Mobile Styles */
@media screen and (max-width: 480px) {
  .instagram-item {
    height: 250px;
  }

  .instagram-item--small {
    width: 180px;
    height: 240px;
  }

  .instagram-item--medium {
    width: 220px;
    height: 280px;
  }

  .instagram-item--large {
    width: 260px;
    height: 320px;
  }
  
  .instagram-follow-text--top {
    margin-bottom: 30px;
  }

  .instagram-follow-text--bottom {
    margin-top: 30px;
  }
}

/* Animation for loading */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.instagram-item {
  animation: fadeIn 0.6s ease forwards;
}

.instagram-item:nth-child(1) { animation-delay: 0.1s; }
.instagram-item:nth-child(2) { animation-delay: 0.2s; }
.instagram-item:nth-child(3) { animation-delay: 0.3s; }
.instagram-item:nth-child(4) { animation-delay: 0.4s; }
.instagram-item:nth-child(5) { animation-delay: 0.5s; }
.instagram-item:nth-child(6) { animation-delay: 0.6s; }
.instagram-item:nth-child(7) { animation-delay: 0.7s; }
.instagram-item:nth-child(8) { animation-delay: 0.8s; }

</style>

<div class="instagram-feed-section section-{{ section.id }}" style="
  background-color: {{ section.settings.background_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
">
  <div class="instagram-feed-wrapper">
    {% if section.settings.show_follow_text and section.settings.text_position == 'top' %}
      <div class="instagram-follow-text instagram-follow-text--top">
        <p class="instagram-text" style="color: {{ section.settings.text_color }};">
          {{ section.settings.follow_text }}
        </p>
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" 
             class="instagram-account-link"
             style="color: {{ section.settings.link_color }};"
             target="_blank" 
             rel="noopener noreferrer">
            {{ section.settings.account_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="instagram-scroll-container{% if section.settings.enable_marquee %} instagram-scroll-container--marquee{% endif %}"
         data-marquee="{{ section.settings.enable_marquee }}"
         data-marquee-speed="{{ section.settings.marquee_speed }}"
         data-marquee-direction="{{ section.settings.marquee_direction }}"
         data-pause-on-hover="{{ section.settings.pause_on_hover }}">
      <div class="instagram-grid" data-marquee-content>
        <div style="width: 100%; height: 100%; display: flex; gap: 20px; min-height: 1000px;">
          {% for block in section.blocks %}
            <div class="instagram-item instagram-item--{{ block.settings.size }}" 
                 data-position="{{ block.settings.position }}"
                 style="
                   {% if block.settings.custom_top %}top: {{ block.settings.custom_top }}%;{% endif %}
                   {% if block.settings.custom_left %}left: {{ block.settings.custom_left }}%;{% endif %}
                 "
                 {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <a href="{{ block.settings.link | default: section.settings.instagram_url }}" 
                   class="instagram-link"
                   {% if block.settings.link != blank or section.settings.instagram_url != blank %}
                     target="_blank"
                     rel="noopener noreferrer"
