                 data-position="{{ block.settings.position }}"
                 style="
                   {% if block.settings.custom_top %}top: {{ block.settings.custom_top }}%;{% endif %}
                   {% if block.settings.custom_left %}left: {{ block.settings.custom_left }}%;{% endif %}
                 "
                 {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <a href="{{ block.settings.link | default: section.settings.instagram_url }}" 
                   class="instagram-link"
                   {% if block.settings.link != blank or section.settings.instagram_url != blank %}
                     target="_blank"
                     rel="noopener noreferrer"
                   {% endif %}>
                  <div class="instagram-image-wrapper">
                    <img
                      src="{{ block.settings.image | image_url: width: 800 }}"
                      srcset="{{ block.settings.image | image_url: width: 400 }} 400w,
                              {{ block.settings.image | image_url: width: 600 }} 600w,
                              {{ block.settings.image | image_url: width: 800 }} 800w"
                      sizes="(max-width: 768px) 100vw, 400px"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}">
                    <div class="instagram-overlay">
                      <svg class="instagram-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" fill="currentColor"/>
                      </svg>
                    </div>
                  </div>
                </a>
              {% else %}
                <div class="instagram-placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          {% endfor %}

        </div>
    </div>
    </div>

    {% if section.settings.show_follow_text and section.settings.text_position == 'center' %}
      <div class="instagram-follow-text instagram-follow-text--center">
        <p class="instagram-text" style="color: {{ section.settings.text_color }};">
          {{ section.settings.follow_text }}
        </p>
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" 
             class="instagram-account-link"
             style="color: {{ section.settings.link_color }};"
             target="_blank" 
             rel="noopener noreferrer">
            {{ section.settings.account_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    {% if section.settings.show_follow_text and section.settings.text_position == 'bottom' %}
      <div class="instagram-follow-text instagram-follow-text--bottom">
        <p class="instagram-text" style="color: {{ section.settings.text_color }};">
          {{ section.settings.follow_text }}
        </p>
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" 
             class="instagram-account-link"
             style="color: {{ section.settings.link_color }};"
             target="_blank" 
             rel="noopener noreferrer">
            {{ section.settings.account_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  // Smooth horizontal scrolling and marquee animation for Instagram feed
  document.addEventListener('DOMContentLoaded', function() {
    const scrollContainers = document.querySelectorAll('.instagram-scroll-container');
    
    scrollContainers.forEach(container => {
      const isMarquee = container.dataset.marquee === 'true';
      const marqueeSpeed = parseFloat(container.dataset.marqueeSpeed) || 40;
      const marqueeDirection = container.dataset.marqueeDirection || 'right';
      const pauseOnHover = container.dataset.pauseOnHover === 'true';
      
      if (isMarquee) {
        // Marquee Animation Setup
        const grid = container.querySelector('[data-marquee-content]');
        const items = Array.from(grid.children);
        
        // Clone items to create seamless loop
        items.forEach(item => {
          const clone = item.cloneNode(true);
          clone.classList.add('instagram-item--clone');
          grid.appendChild(clone);
        });
        
        // Calculate total width
        let totalWidth = 0;
        items.forEach(item => {
          totalWidth += item.offsetWidth + 20; // 20px is gap
        });
        
        // Set the animation duration based on content width for consistent speed
        const duration = marqueeDirection === 'right' ? marqueeSpeed : marqueeSpeed;
        
        // Apply animation
        const animationName = `marqueeScroll${marqueeDirection === 'left' ? 'Left' : 'Right'}`;
        grid.style.animation = `${animationName} ${duration}s linear infinite`;
        
        // Pause on hover
        if (pauseOnHover) {
          container.addEventListener('mouseenter', () => {
            grid.style.animationPlayState = 'paused';
          });
          
          container.addEventListener('mouseleave', () => {
            grid.style.animationPlayState = 'running';
          });
        }
        
        // Disable manual scrolling in marquee mode
        container.style.overflow = 'hidden';
        
      } else {
        // Manual Scrolling Setup (original functionality)
        let isDown = false;
        let startX;
        let scrollLeft;
        
        // Mouse drag scrolling
        container.addEventListener('mousedown', (e) => {
          isDown = true;
          container.classList.add('active');
          startX = e.pageX - container.offsetLeft;
          scrollLeft = container.scrollLeft;
          container.style.cursor = 'grabbing';
        });
        
        container.addEventListener('mouseleave', () => {
          isDown = false;
          container.classList.remove('active');
          container.style.cursor = 'grab';
        });
        
        container.addEventListener('mouseup', () => {
          isDown = false;
          container.classList.remove('active');
          container.style.cursor = 'grab';
        });
        
        container.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - container.offsetLeft;
          const walk = (x - startX) * 2; // Scroll speed multiplier
          container.scrollLeft = scrollLeft - walk;
        });
        
        // Smooth mouse wheel scrolling
        container.addEventListener('wheel', (e) => {
          e.preventDefault();
          container.scrollLeft += e.deltaY;
        });
        
        // Touch scrolling
        let touchStartX = 0;
        let touchScrollLeft = 0;
        
        container.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].pageX;
          touchScrollLeft = container.scrollLeft;
        });
        
        container.addEventListener('touchmove', (e) => {
          const touchX = e.touches[0].pageX;
          const walk = (touchStartX - touchX) * 1.5;
          container.scrollLeft = touchScrollLeft + walk;
        });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section-instagram-feed",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Marquee Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Marquee Animation",
      "default": false,
      "info": "Automatically scroll images continuously"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "s",
      "label": "Animation Speed",
      "default": 40,
      "info": "Lower = faster, Higher = slower"
    },
    {
      "type": "select",
      "id": "marquee_direction",
      "label": "Scroll Direction",
      "options": [
        {
          "value": "left",
          "label": "Left to Right"
        },
        {
          "value": "right",
          "label": "Right to Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on Hover",
      "default": true,
      "info": "Stop animation when user hovers over images"
    },
    {
      "type": "header",
      "content": "Follow Text Settings"
    },
    {
      "type": "checkbox",
      "id": "show_follow_text",
      "label": "Show Follow Text",
      "default": true
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text Position",
      "options": [
        {
          "value": "top",
          "label": "Above Gallery"
        },
        {
          "value": "center",
          "label": "Center of Gallery"
        },
        {
          "value": "bottom",
          "label": "Below Gallery"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "follow_text",
      "label": "Follow Text",
      "default": "Follow us on Instagram"
    },
    {
      "type": "text",
      "id": "account_text",
      "label": "Account Link Text",
      "default": "OUR ACCOUNT"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "info": "Enter your Instagram profile URL"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#000000"
    }
  ],
  "blocks": [
